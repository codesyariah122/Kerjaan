add_action('admin_menu', 'pindahkan_menu_woocommerce_ke_atas', 999);
function pindahkan_menu_woocommerce_ke_atas() {
    global $menu;

    foreach ($menu as $key => $item) {
        if (isset($item[2]) && $item[2] === 'woocommerce') {
            // Ambil data asli
            $wc_menu = $item;
            // Ganti label dan ikon
            $wc_menu[0] = 'Toko';

            // Hapus menu WooCommerce dari posisi lama
            unset($menu[$key]);

            // Tambahkan di awal (paling atas, setelah Dashboard)
            array_splice($menu, 1, 0, [$wc_menu]);

            break;
        }
    }
}

add_action('admin_bar_menu', 'hapus_icon_wordpress', 999);
function hapus_icon_wordpress($wp_admin_bar) {
    $wp_admin_bar->remove_node('wp-logo');
}

